{
  "name": "照片整理归档",
  "description": "图片压缩(WebP,1920px) → 重命名({date}-{index:3}) → 打包(zip)",
  "nodes": [
    {
      "id": "node-1",
      "nodeType": "image_compress",
      "label": "图片压缩",
      "position": { "x": 100, "y": 200 },
      "params": {
        "quality": 80,
        "format": "webp",
        "maxWidth": 1920
      }
    },
    {
      "id": "node-2",
      "nodeType": "file_rename",
      "label": "批量重命名",
      "position": { "x": 400, "y": 200 },
      "params": {
        "pattern": "{date}-{index:3}"
      }
    },
    {
      "id": "node-3",
      "nodeType": "file_archive",
      "label": "打包",
      "position": { "x": 700, "y": 200 },
      "params": {
        "format": "zip",
        "archiveName": "photos-archive"
      }
    }
  ],
  "edges": [
    { "id": "edge-1", "source": "node-1", "target": "node-2" },
    { "id": "edge-2", "source": "node-2", "target": "node-3" }
  ]
}
